// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  name String
  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @updatedAt

  ownedGroups Group[] @relation("GroupOwner")
  groupMemberships GroupMember[]
  expenseParticipants ExpenseParticipant[]
  expensesPaid Expense[]
  settlementsPaid Settlement[] @relation("SettlementPayer")
  settlementsReceived Settlement[] @relation("SettlementReceiver")

  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?
  
}

model Group {
  id String @id @default(uuid())
  name String 
  description String? 

  owner User @relation("GroupOwner", fields: [userId], references: [id]) 
  userId String 


  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @updatedAt

  members GroupMember[]
  expenses Expense[]
  settlements Settlement[]
  
}

model GroupMember {
  id String @id @default(uuid())
  
  user User @relation(fields: [userId], references: [id])
  userId String

  group Group @relation(fields: [groupId], references: [id])
  groupId String

 

  joinedAt DateTime @default(now())
  @@unique([userId, groupId])
}

model Expense {
  id String @id @default(uuid())
  amount Decimal 
  title String
  description String?


  paidBy User @relation(fields: [userId], references: [id])
  userId String

  group Group @relation(fields: [groupId], references: [id])
  groupId String

  splitType SplitType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenseParticipants ExpenseParticipant[]
}

model ExpenseParticipant {
  id String @id @default(uuid())

  user User @relation(fields: [userId], references: [id])
  userId String
  amountOwed Decimal

  expense Expense @relation(fields: [expenseId], references: [id])
  expenseId String

  createdAt DateTime @default(now())
  @@unique([userId, expenseId])
}

model Settlement {
  id String @id @default(uuid())

  paidBy User @relation("SettlementPayer", fields: [payerId], references: [id])
  payerId String

  receivedBy User @relation("SettlementReceiver", fields: [receiverId], references: [id])
  receiverId String

  amount Decimal
  description String?

  group Group @relation(fields: [groupId], references: [id])
  groupId String

  createdAt DateTime @default(now())

}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

